{
  "private": true,
  "name": "praha-challenge-ddd-template",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite-node --watch src/index.ts",
    "build": "vite build",
    "start": "node dist/index.mjs",
    "lint": "biome ci .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "tsc --pretty --noEmit",
    "migration:generate": "drizzle-kit generate",
    "migration:apply": "drizzle-kit migrate",
    "migration:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "just-memoize": "2.2.0",
    "postgres": "3.4.9",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vitest": "5.1.0"
  }
}
